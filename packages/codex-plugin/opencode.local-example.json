{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./src",
      "options": {
        "enableCodex": true,
        "timeoutMs": 90000
      }
    }
  ],
  "agents": {
    "build": {
      "permissions": [
        {
          "action": "subagent",
          "resource": "codex",
          "effect": "allow"
        }
      ]
    }
  }
}
