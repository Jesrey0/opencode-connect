[Unit]
Description=OpenCode Connect MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/opencode-connect/current
Environment=NODE_ENV=production
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node %h/.local/lib/opencode-connect/current/dist/src/server.js
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
