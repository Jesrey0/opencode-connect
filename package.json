{
  "name": "opencode-connect",
  "version": "0.14.2",
  "private": true,
  "description": "Native OpenCode HostPlane and canonical WorkerPlane for ChatGPT operators.",
  "type": "module",
  "scripts": {
    "browser:setup": "node scripts/setup-browser.mjs",
    "browser:benchmark": "node --import tsx scripts/benchmark-browser.mjs",
    "operator:benchmark": "node --import tsx scripts/benchmark-operator.mjs",
    "test:browser": "node --import tsx --test --test-concurrency=1 test/browser*.test.ts",
    "prebuild": "node scripts/verify-integration.mjs && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "precheck": "node scripts/verify-native-client.mjs",
    "pretest": "node scripts/verify-native-client.mjs",
    "dev": "tsx src/server.ts",
    "console": "tsx src/console.ts",
    "console:dist": "node dist/src/console.js",
    "start": "node dist/src/server.js",
    "deploy": "node dist/src/deploy.js",
    "test": "node --import tsx --test test/*.test.ts",
    "check:all": "npm run verify:release && npm run check && npm run check --workspace opencode-codex-subagent && node scripts/verify-integration.mjs",
    "test:all": "npm test && npm test --workspace opencode-codex-subagent",
    "verify:integration": "node scripts/verify-integration.mjs",
    "verify:release": "node scripts/verify-release-version.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@opencode/client": "2.0.24",
    "express": "5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/codex-plugin"
  ]
}
